# Copy to .env (git-ignored) and fill in every secret. msapi refuses to
# start with missing, short or placeholder secrets (see SECURITY.md).
#
# Generate the three secrets:
#   openssl rand -hex 32        -> MSAPI_API_KEY
#   openssl rand -base64 32     -> MSAPI_SECRET_KEY
#   openssl rand -base64 18     -> MSAPI_ADMIN_PASSWORD (or your own, 12+ characters)

# --- Ports -------------------------------------------------------------------
MAPSERVER_PORT=8080
# Public WMS/WFS. 127.0.0.1 = maps only through the web UI's nginx (/ows).
MAPSERVER_BIND=0.0.0.0
MSAPI_PORT=8081
# Admin API. Keep 127.0.0.1 unless the web UI runs on another host; then
# use 0.0.0.0 and firewall the port to that host only.
MSAPI_BIND=127.0.0.1
# Seconds one map request may take (default 180). Raise it for very large
# rasters that are not Cloud Optimized GeoTIFFs.
# MAPSERVER_TIMEOUT=180

# --- Admin UI sign-in --------------------------------------------------------
MSAPI_ADMIN_USER=admin
# Required, at least 12 characters, not a default. Changing it signs
# everybody out.
MSAPI_ADMIN_PASSWORD=
# Absolute session lifetime (hours) and inactivity timeout (minutes).
MSAPI_SESSION_HOURS=8
MSAPI_SESSION_IDLE_MINUTES=30
# Failed sign-ins per username or client IP before a lockout, and its length.
MSAPI_LOGIN_MAX_ATTEMPTS=5
MSAPI_LOGIN_LOCKOUT_MINUTES=15

# --- API access for scripts (X-API-Key header) --------------------------------
# Required, at least 32 characters.
MSAPI_API_KEY=

# 32 bytes, base64. Encrypts store passwords in msadmin.db (AES-256-GCM) and
# signs sessions. Keep it with your backups, NOT inside them. Losing it =
# re-enter store passwords.
MSAPI_SECRET_KEY=

# --- Network -----------------------------------------------------------------
# Proxies allowed to report the client IP (X-Real-IP / X-Forwarded-For), as
# CIDRs. Empty = loopback and private ranges (the web UI's nginx on gis-net).
# If the API port is reachable from untrusted private networks, list only
# the nginx host, e.g. 10.0.0.5/32.
MSAPI_TRUSTED_PROXIES=

# Public base URL of MapServer, used in WMS capabilities (wms_onlineresource).
MSAPI_PUBLIC_URL=http://localhost:8080/

# --- Misc --------------------------------------------------------------------
# Serve the OpenAPI spec and Swagger UI without sign-in (off in production).
MSAPI_PUBLIC_DOCS=off
# Local development only: accept weak passwords and keys. Never in production.
MSAPI_INSECURE_DEV=false
MSAPI_LOG_LEVEL=info

# Host folder with GeoTIFFs for "local folder" raster stores. Mounted
# read-only at /rasters in both mapserver and msapi. Each store points at
# this folder or a subfolder of it.
RASTER_DIR=./rasters
