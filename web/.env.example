WEB_PORT=3000
# Address to publish on. 0.0.0.0 = all interfaces; 127.0.0.1 when the TLS
# proxy (docker-compose.tls.yml) or another reverse proxy on this host is the
# only way in.
WEB_BIND=0.0.0.0

# Same host (default): service names on the gis-net network.
MSAPI_UPSTREAM=http://msapi:8081
MAPSERVER_UPSTREAM=http://mapserver:80
# Different host: e.g. MSAPI_UPSTREAM=http://10.0.0.5:8081

# Proxy allowed to tell nginx the client IP (X-Forwarded-For). Leave as is
# unless a reverse proxy sits in front; docker-compose.tls.yml sets it.
NGINX_REAL_IP_FROM=127.0.0.1/32

# HTTPS with docker-compose.tls.yml (automatic Let's Encrypt certificate).
# The domain's DNS must point at this host and ports 80/443 must be open.
# MAPNEST_DOMAIN=maps.example.com
# MAPNEST_ACME_EMAIL=you@example.com
