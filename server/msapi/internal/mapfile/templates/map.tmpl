# Generated by msapi. Do not edit: msadmin.db is the source of truth and
# this file is overwritten on every change (PLAN.md §3).
MAP
  NAME "services"
  STATUS ON
  SIZE 800 600
  UNITS DD
  EXTENT -180 -90 180 90
  IMAGECOLOR 255 255 255
  IMAGETYPE "png"
  SYMBOLSET "symbols.sym"
{{- if .Fontset}}
  FONTSET "fonts/fontset.txt"
{{- end}}
  MAXSIZE 4096
{{- range .Config}}
  CONFIG {{q .Key}} {{q .Value}}
{{- end}}

  PROJECTION
    "EPSG:4326"
  END

  WEB
    METADATA
      "ows_title"              {{q (or .Title "MapServer services")}}
      "ows_srs"                "EPSG:4326 EPSG:3857 EPSG:900913"
      "ows_onlineresource"     {{q .PublicURL}}
      "wms_enable_request"     "*"
      "wfs_enable_request"     "!*"
      "wms_feature_info_mime_type" "text/html"
      "wfs_getfeature_formatlist" "geojson"
      # Security (docs/security/VAPT-L1.md): no client-supplied SLD (SLD=
      # would make MapServer fetch any URL), and a cap on WFS features per
      # request so one call cannot dump or overload a large table.
      "wms_sld_enabled"        "false"
      "wfs_maxfeatures"        "10000"
    END
  END

  OUTPUTFORMAT
    NAME "png"
    DRIVER "AGG/PNG"
    MIMETYPE "image/png"
    IMAGEMODE RGBA
    EXTENSION "png"
    TRANSPARENT ON
  END

  OUTPUTFORMAT
    NAME "jpeg"
    DRIVER "AGG/JPEG"
    MIMETYPE "image/jpeg"
    IMAGEMODE RGB
    EXTENSION "jpg"
  END

  OUTPUTFORMAT
    NAME "geojson"
    DRIVER "OGR/GEOJSON"
    MIMETYPE "application/json; subtype=geojson"
    FORMATOPTION "STORAGE=stream"
    FORMATOPTION "FORM=SIMPLE"
  END

  LEGEND
    KEYSIZE 20 14
  END
{{range .Layers}}
  LAYER
    NAME {{q .Name}}
{{- if .Group}}
    GROUP {{q .Group}}
{{- end}}
    TYPE {{.Type}}
    STATUS ON
{{- if .Connection}}
    CONNECTIONTYPE POSTGIS
    CONNECTION {{q .Connection}}
    PROCESSING "CLOSE_CONNECTION=DEFER"
{{- end}}
    DATA {{q .Data}}
{{- range .Processing}}
    PROCESSING {{q .}}
{{- end}}
{{- if .Offsite}}
    OFFSITE {{.Offsite}}
{{- end}}
{{- if .Opacity}}
    COMPOSITE
      OPACITY {{deref_i .Opacity}}
    END
{{- end}}
{{- if .MinScale}}
    MINSCALEDENOM {{num (deref .MinScale)}}
{{- end}}
{{- if .MaxScale}}
    MAXSCALEDENOM {{num (deref .MaxScale)}}
{{- end}}
{{- if eq .Projection "AUTO"}}
    PROJECTION
      AUTO
    END
{{- else}}
    PROJECTION
      {{q .Projection}}
    END
{{- end}}
{{- if .Extent}}
    EXTENT {{num .Extent.MinX}} {{num .Extent.MinY}} {{num .Extent.MaxX}} {{num .Extent.MaxY}}
{{- end}}
    METADATA
      "ows_title"          {{q (or .Title .Name)}}
{{- if .Abstract}}
      "ows_abstract"       {{q .Abstract}}
{{- end}}
{{- if .SRS}}
      "ows_srs"            {{q .SRS}}
{{- end}}
{{- if .Extent}}
      "ows_extent"         "{{num .Extent.MinX}} {{num .Extent.MinY}} {{num .Extent.MaxX}} {{num .Extent.MaxY}}"
{{- end}}
{{- if ne .Type "RASTER"}}
      "wfs_enable_request" {{if .WFS}}"*"{{else}}"!*"{{end}}
{{- if .WMSOff}}
      "wms_enable_request" "!*"
{{- end}}
{{- if .Group}}
      "wms_group_title"    {{q (or .Title .Group)}}
{{- end}}
{{- if .GeomColumn}}
      "gml_exclude_items"  {{q .GeomColumn}}
{{- end}}
      "gml_include_items"  "all"
      "wms_include_items"  "all"
      "gml_featureid"      {{q .PK}}
      "gml_types"          "auto"
{{- end}}
    END
{{- if ne .Type "RASTER"}}
    TEMPLATE "query"
{{- end}}
{{- if .ClassGroup}}
    CLASSGROUP {{q .ClassGroup}}
{{- end}}
{{- if .Classes}}
{{indent 4 .Classes}}
{{- end}}
  END
{{end}}
END
